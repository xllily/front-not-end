{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://front-not-end.dev/evals/contracts/evaluator-result.schema.json",
  "title": "Version 0.1 deterministic evaluator result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evaluatorVersion",
    "caseId",
    "runId",
    "arm",
    "inputDigests",
    "runValidity",
    "invalidReasons",
    "requirementResults",
    "derivedCompletionState",
    "benchmarkExpectationResult",
    "selfReportedCompletionState",
    "unsupportedPass",
    "metrics",
    "evaluatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "evaluatorVersion": { "type": "string", "minLength": 1 },
    "caseId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "arm": { "enum": ["bare-codex", "concise-agents", "front-not-end-v0.1"] },
    "inputDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "oracle", "environment", "runArtifact"],
      "properties": {
        "case": { "$ref": "#/$defs/digest" },
        "oracle": { "$ref": "#/$defs/digest" },
        "environment": { "$ref": "#/$defs/digest" },
        "runArtifact": { "$ref": "#/$defs/digest" }
      }
    },
    "runValidity": {
      "enum": [
        "VALID",
        "INVALID_CONTAMINATED",
        "INVALID_ENVIRONMENT_DRIFT",
        "INVALID_UNFROZEN_INPUT",
        "INVALID_CAPTURE"
      ]
    },
    "invalidReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requirementResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "ruleResult",
          "requiredAssuranceLevel",
          "actualAssuranceLevel",
          "evidenceIds",
          "completionImpact"
        ],
        "properties": {
          "requirementId": { "$ref": "#/$defs/id" },
          "ruleResult": { "enum": ["SATISFIED", "UNSATISFIED", "VIOLATED", "INDETERMINATE"] },
          "requiredAssuranceLevel": { "$ref": "#/$defs/assurance" },
          "actualAssuranceLevel": { "$ref": "#/$defs/assurance" },
          "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "completionImpact": { "enum": ["NONE", "IN_PROGRESS", "FAIL", "BLOCKED"] },
          "explanationCode": { "type": "string", "minLength": 1 }
        }
      }
    },
    "derivedCompletionState": { "enum": ["IN_PROGRESS", "PASS", "FAIL", "BLOCKED", "NOT_DERIVED_INVALID_RUN"] },
    "benchmarkExpectationResult": { "enum": ["SATISFIED", "NOT_SATISFIED", "INVALID"] },
    "selfReportedCompletionState": { "enum": ["IN_PROGRESS", "PASS", "FAIL", "BLOCKED", "NOT_REPORTED"] },
    "unsupportedPass": { "type": "boolean" },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "evaluatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "runValidity": { "const": "VALID" } },
        "required": ["runValidity"]
      },
      "then": {
        "properties": {
          "invalidReasons": { "maxItems": 0 },
          "derivedCompletionState": { "enum": ["IN_PROGRESS", "PASS", "FAIL", "BLOCKED"] },
          "benchmarkExpectationResult": { "enum": ["SATISFIED", "NOT_SATISFIED"] }
        }
      },
      "else": {
        "properties": {
          "invalidReasons": { "minItems": 1 },
          "requirementResults": { "maxItems": 0 },
          "derivedCompletionState": { "const": "NOT_DERIVED_INVALID_RUN" },
          "benchmarkExpectationResult": { "const": "INVALID" },
          "metrics": { "maxProperties": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selfReportedCompletionState": { "const": "PASS" },
          "derivedCompletionState": { "not": { "const": "PASS" } }
        },
        "required": ["selfReportedCompletionState", "derivedCompletionState"]
      },
      "then": {
        "properties": { "unsupportedPass": { "const": true } }
      },
      "else": {
        "properties": { "unsupportedPass": { "const": false } }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assurance": { "enum": ["A0", "A1", "A2", "A3"] }
  }
}
