{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://front-not-end.dev/evals/contracts/case.schema.json",
  "title": "Version 0.1 benchmark case input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "title",
    "lifecycle",
    "agentInput",
    "fixture",
    "comparison",
    "capture",
    "controlLink"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "caseId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authoredAt", "frozenAt", "authoringBaseRevision"],
      "properties": {
        "state": { "enum": ["DRAFT", "FROZEN"] },
        "authoredAt": { "type": "string", "format": "date-time" },
        "frozenAt": { "type": ["string", "null"], "format": "date-time" },
        "authoringBaseRevision": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] }
      }
    },
    "agentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "organizationContext", "otherInputs"],
      "properties": {
        "task": { "$ref": "#/$defs/artifact" },
        "organizationContext": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" },
          "uniqueItems": true
        },
        "otherInputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" },
          "uniqueItems": true
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "manifest", "repositoryRevision", "projectionDigest"],
      "properties": {
        "fixtureId": { "$ref": "#/$defs/id" },
        "manifest": { "$ref": "#/$defs/artifact" },
        "repositoryRevision": { "$ref": "#/$defs/revision" },
        "projectionDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arms", "allowedDifference", "independentRunsPerArm", "identicalFactors"],
      "properties": {
        "arms": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["bare-codex", "concise-agents", "front-not-end-v0.1"] }
        },
        "allowedDifference": { "const": "intervention" },
        "independentRunsPerArm": { "type": "integer", "minimum": 1 },
        "identicalFactors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "task",
              "fixture-revision",
              "outer-instructions",
              "skills",
              "plugins",
              "host-settings",
              "model-version",
              "tool-permissions",
              "operating-environment",
              "evidence-access",
              "run-count"
            ]
          },
          "allOf": [
            { "contains": { "const": "task" } },
            { "contains": { "const": "fixture-revision" } },
            { "contains": { "const": "outer-instructions" } },
            { "contains": { "const": "skills" } },
            { "contains": { "const": "plugins" } },
            { "contains": { "const": "host-settings" } },
            { "contains": { "const": "model-version" } },
            { "contains": { "const": "tool-permissions" } },
            { "contains": { "const": "operating-environment" } },
            { "contains": { "const": "evidence-access" } },
            { "contains": { "const": "run-count" } }
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentManifest", "runArtifact", "retain"],
      "properties": {
        "environmentManifest": { "const": "comparison-environment.schema.json" },
        "runArtifact": { "const": "run-artifact.schema.json" },
        "retain": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "task-output",
              "tool-evidence",
              "completion-state",
              "elapsed-time",
              "token-or-cost",
              "repository-state"
            ]
          },
          "allOf": [
            { "contains": { "const": "task-output" } },
            { "contains": { "const": "tool-evidence" } },
            { "contains": { "const": "completion-state" } },
            { "contains": { "const": "elapsed-time" } },
            { "contains": { "const": "token-or-cost" } },
            { "contains": { "const": "repository-state" } }
          ]
        }
      }
    },
    "controlLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracleId"],
      "properties": {
        "oracleId": { "$ref": "#/$defs/id" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "properties": { "state": { "const": "FROZEN" } },
            "required": ["state"]
          }
        }
      },
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "frozenAt": { "type": "string", "format": "date-time" },
              "authoringBaseRevision": { "$ref": "#/$defs/revision" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/strictRelativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
