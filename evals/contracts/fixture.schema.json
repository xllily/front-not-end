{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://front-not-end.dev/evals/contracts/fixture.schema.json",
  "title": "Version 0.1 benchmark fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "repository", "materialization", "agentProjection", "baseline"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "fixtureId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "treeDigest", "clean"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "treeDigest": { "$ref": "#/$defs/digest" },
        "clean": { "const": true }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "recipe", "resultDigest"],
      "properties": {
        "method": { "enum": ["git-worktree", "content-addressed-archive", "deterministic-generator"] },
        "recipe": { "$ref": "#/$defs/artifact" },
        "resultDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "agentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "allowlist",
        "denylist",
        "projectionDigest",
        "preflightCommand",
        "containmentPolicy"
      ],
      "properties": {
        "root": { "$ref": "common.schema.json#/$defs/strictRelativePath" },
        "allowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/strictRelativePath" }
        },
        "denylist": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/strictRelativePath" },
          "allOf": [
            { "contains": { "pattern": "oracle" } },
            { "contains": { "pattern": "holdout" } },
            { "contains": { "pattern": "evaluator" } },
            { "contains": { "pattern": "control" } }
          ]
        },
        "projectionDigest": { "$ref": "#/$defs/digest" },
        "preflightCommand": { "type": "string", "minLength": 1 },
        "containmentPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolution", "rejectSymlinkEscape", "failClosed"],
          "properties": {
            "resolution": { "const": "realpath-descendant-of-declared-root" },
            "rejectSymlinkEscape": { "const": true },
            "failClosed": { "const": true }
          }
        }
      }
    },
    "organizationContext": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentsFile", "digest"],
      "properties": {
        "agentsFile": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/strictRelativePath" },
            { "pattern": "(^|/)AGENTS\\.md$" }
          ]
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/strictRelativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
