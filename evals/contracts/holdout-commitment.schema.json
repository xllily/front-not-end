{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://front-not-end.dev/evals/contracts/holdout-commitment.schema.json",
  "title": "Version 0.1 holdout bundle commitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "groupId",
    "caseCount",
    "coverageSummary",
    "canonicalization",
    "sealedBundleDigest",
    "sealedAt",
    "stewardRole",
    "openingCondition",
    "authoringBaseRevision"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "groupId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "caseCount": { "type": "integer", "minimum": 1 },
    "coverageSummary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonicalization": { "const": "RFC8785-JCS" },
    "sealedBundleDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sealedAt": { "type": "string", "format": "date-time" },
    "stewardRole": { "type": "string", "minLength": 1 },
    "openingCondition": { "const": "adapter-revision-frozen-and-development-access-revoked" },
    "authoringBaseRevision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
  }
}
