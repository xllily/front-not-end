{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://front-not-end.dev/evals/contracts/oracle.schema.json",
  "title": "Version 0.1 hidden benchmark oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "oracleId",
    "caseId",
    "caseDigest",
    "frozenAt",
    "expectedRiskTiers",
    "expectedCompletionStates",
    "referenceStackFit",
    "facts",
    "requirements",
    "tolerances",
    "metrics",
    "completionRule"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "oracleId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "caseDigest": { "$ref": "#/$defs/digest" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "expectedRiskTiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["Routine", "Material", "High", "Critical"] }
    },
    "expectedCompletionStates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["IN_PROGRESS", "PASS", "FAIL", "BLOCKED"] }
    },
    "referenceStackFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "factIds", "allowedArchitecture", "forbiddenArchitecture"],
      "properties": {
        "expected": { "enum": ["FIT", "MISMATCH", "NOT_APPLICABLE"] },
        "factIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "allowedArchitecture": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "forbiddenArchitecture": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factId", "statement", "basis"],
        "properties": {
          "factId": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 1 },
          "basis": { "$ref": "#/$defs/basisList" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "class",
          "polarity",
          "statement",
          "severity",
          "mustCatch",
          "blockingCompletion",
          "requiredAssuranceLevel",
          "evidenceCategories",
          "insufficientAssuranceOutcome",
          "basis",
          "deterministicRule",
          "metricIds"
        ],
        "properties": {
          "requirementId": { "$ref": "#/$defs/id" },
          "class": {
            "enum": [
              "system-profile",
              "concern",
              "organization-constraint",
              "existing-capability",
              "solution-space",
              "reference-stack-fit",
              "architecture",
              "avoidable-reimplementation",
              "unjustified-infrastructure",
              "production-surface",
              "risk-tier",
              "evidence",
              "completion",
              "user-question",
              "noise"
            ]
          },
          "polarity": { "enum": ["REQUIRED", "FORBIDDEN"] },
          "statement": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["Routine", "Material", "High", "Critical"] },
          "mustCatch": { "type": "boolean" },
          "blockingCompletion": { "type": "boolean" },
          "requiredAssuranceLevel": { "$ref": "#/$defs/assurance" },
          "evidenceCategories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/evidenceCategory" }
          },
          "insufficientAssuranceOutcome": { "$ref": "#/$defs/nonPassing" },
          "basis": { "$ref": "#/$defs/basisList" },
          "deterministicRule": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operator", "selector", "expected"],
            "properties": {
              "operator": {
                "enum": [
                  "exists",
                  "absent",
                  "equals",
                  "contains",
                  "matches",
                  "executed-check-passed",
                  "control-enforced",
                  "expert-adjudication-equals"
                ]
              },
              "selector": { "type": "string", "minLength": 1 },
              "expected": {},
              "normalization": { "enum": ["none", "trim", "lowercase", "json-canonical"] }
            }
          },
          "metricIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["falsePositiveMaximum", "routineNoiseMaximum", "unjustifiedComplexityMaximum"],
      "properties": {
        "falsePositiveMaximum": { "type": "number", "minimum": 0 },
        "routineNoiseMaximum": { "type": "number", "minimum": 0 },
        "unjustifiedComplexityMaximum": { "type": "number", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metricId", "aggregation", "threshold", "comparisonDirection"],
        "properties": {
          "metricId": { "$ref": "#/$defs/id" },
          "aggregation": { "enum": ["all", "count", "rate", "sum", "mean"] },
          "threshold": { "type": "number" },
          "comparisonDirection": { "enum": ["higher", "lower", "exact"] }
        }
      }
    },
    "completionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failurePrecedence", "passRequiresAllBlockingSatisfied", "unsupportedPassForbidden"],
      "properties": {
        "failurePrecedence": {
          "type": "array",
          "const": ["FAIL", "BLOCKED", "IN_PROGRESS", "PASS"]
        },
        "passRequiresAllBlockingSatisfied": { "const": true },
        "unsupportedPassForbidden": { "const": true }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assurance": { "enum": ["A0", "A1", "A2", "A3"] },
    "nonPassing": { "enum": ["IN_PROGRESS", "FAIL", "BLOCKED"] },
    "evidenceCategory": {
      "enum": [
        "agent-output",
        "repository-artifact",
        "test-output",
        "command-output",
        "query-output",
        "review-artifact",
        "ci-gate",
        "runtime-control",
        "external-control",
        "expert-adjudication"
      ]
    },
    "basisList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "digest", "rationale"],
        "properties": {
          "kind": {
            "enum": [
              "fixture-fact",
              "repository-invariant",
              "executable-invariant",
              "product-contract",
              "organization-rule",
              "expert-judgment"
            ]
          },
          "reference": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "rationale": { "type": "string", "minLength": 1 },
          "adjudicator": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "expert-judgment" } }, "required": ["kind"] },
            "then": { "required": ["adjudicator"] }
          }
        ]
      }
    }
  }
}
